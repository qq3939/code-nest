# 复制为 .env 后修改。.env 已被 .gitignore 排除，密钥只放在这里，不要提交到仓库。
# 本文件的格式同时兼容 Docker Compose 和 Spring 的 properties（dev profile 会直接读取它）。

# ---------- MySQL ----------
# root 密码只用于容器初始化；应用用下面的普通账号连接
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=project_a
MYSQL_USER=project_a
MYSQL_PASSWORD=change_me_mysql

# ---------- Redis ----------
REDIS_PASSWORD=change_me_redis

# ---------- RabbitMQ（管理界面 http://localhost:15672） ----------
RABBITMQ_USER=project_a
RABBITMQ_PASSWORD=change_me_rabbit

# ---------- MinIO（控制台 http://localhost:9001），密码至少 8 位 ----------
MINIO_ROOT_USER=project_a
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_BUCKET=project-a

# ---------- 认证 ----------
# 至少 32 字节的随机串，可以用 `openssl rand -base64 48` 生成
JWT_SECRET=please-change-this-to-a-random-string-at-least-32-bytes

# ---------- 第一个管理员（启动时不存在才创建） ----------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_admin

# ---------- 搜索 ----------
# true 时需要用 `docker compose --profile search up -d` 启动 Elasticsearch；false 时搜索退回 MySQL LIKE
SEARCH_ENABLED=false
